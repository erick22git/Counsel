# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca exponer al navegador. Se usa para invitar al portal, enviar emails e ingesta de leyes.
SUPABASE_SERVICE_ROLE_KEY=

# IA (Claude). Sin esta clave la IA muestra un aviso y el resto de la app funciona.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Embeddings opcionales para búsqueda semántica de leyes (Voyage AI). Sin clave se usa búsqueda de texto completo.
VOYAGE_API_KEY=

# Email (Resend). Sin clave, las notificaciones quedan en cola en la tabla notifications.
RESEND_API_KEY=
EMAIL_FROM="Counsel <no-responder@tudominio.bo>"

# URL pública de la app (para enlaces en emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto para el cron que envía recordatorios (/api/cron/recordatorios)
CRON_SECRET=

# ───── Sprint 5–6 ─────
# Proveedor de IA: ollama (por defecto, local y gratis) | gemini | anthropic | openai | mock
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIER=paid   # solo si tienes facturación activa (cambia el aviso de privacidad)
# Endpoint compatible con OpenAI (LM Studio, vLLM, Groq, OpenRouter, OpenAI)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Embeddings (opcional): none | voyage | ollama | gemini | openai. Cambiar de modelo con otra dimensión
# obliga a migrar la columna vector y re-ingestar (ver supabase/templates/change-embedding-dimension.sql).
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=
EMBEDDINGS_DIM=1024
# Límites de uso de IA
AI_DAILY_LIMIT_PER_USER=150
AI_DAILY_LIMIT_PER_FIRM=500
AI_BURST_PER_MINUTE=20
# Rate limiting distribuido (opcional; sin esto usa memoria por instancia)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
