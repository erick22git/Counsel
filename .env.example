# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca exponer al navegador. Se usa para invitar al portal, enviar emails e ingesta de leyes.
SUPABASE_SERVICE_ROLE_KEY=

# IA (Claude). Sin esta clave la IA muestra un aviso y el resto de la app funciona.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Embeddings opcionales para búsqueda semántica de leyes (Voyage AI). Sin clave se usa búsqueda de texto completo.
VOYAGE_API_KEY=

# Email (Resend). Sin clave, las notificaciones quedan en cola en la tabla notifications.
RESEND_API_KEY=
EMAIL_FROM="Counsel <no-responder@tudominio.bo>"

# URL pública de la app (para enlaces en emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto para el cron que envía recordatorios (/api/cron/recordatorios)
CRON_SECRET=
